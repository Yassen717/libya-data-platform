# Copy to .env to override. Host-published ports only — container-internal
# ports stay conventional (API on 8000, Grafana on 3000, Postgres on 5432).

# --- Host port mappings (defaults chosen to avoid common local collisions) ---
API_PORT=8000
GRAFANA_PORT=3100
REDPANDA_KAFKA_PORT=19092
REDPANDA_CONSOLE_PORT=8080
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
POSTGRES_PORT=55432
PROMETHEUS_PORT=9090
AIRFLOW_PORT=8085

# --- Credentials (dev defaults — never commit real secrets) ---
POSTGRES_USER=ly
POSTGRES_PASSWORD=devpass
POSTGRES_DB=libya
CLICKHOUSE_USER=ly
CLICKHOUSE_PASSWORD=devpass
CLICKHOUSE_DB=libya
GRAFANA_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_JWT_SECRET=dev-jwt-secret-change-me

# --- Pipeline ---
TOPIC_EVENTS=ly.events.raw
TOPIC_DLQ=ly.events.dlq

# --- Producers ---
GDELT_QUERY=libya
GDELT_MAX_RECORDS=250
GDELT_POLL_INTERVAL_SECONDS=300
WORLDBANK_INDICATORS=NY.GDP.PETR.RT.ZS,NY.GDP.MKTP.CD,SP.POP.TOTL
WORLDBANK_POLL_INTERVAL_SECONDS=86400
